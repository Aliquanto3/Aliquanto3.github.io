---
// Section « Projets », alimentée par src/data/projets.json (instantané généré
// au build par scripts/projets.mjs depuis portfolio.json et l'API GitHub).
//
// Correspondance état -> couleurs de badge, alignée sur les emojis du README du
// profil, avec les seules variables de la charte (charte-generique v2.1.0) ;
// fond en teinte « -doux » ou --sur-statut, texte --texte ou --alerte-texte,
// bordure (« puce ») en couleur vive :
//   status-deployed 🟢 -> --succes-doux / --succes
//   status-refonte  🟠 -> --alerte-doux / --alerte (texte --alerte-texte)
//   status-test     🔵 -> --primaire-doux / --primaire
//   status-bench    🟣 -> --sur-statut / --cat-4 (seule teinte violacée de la charte)
//   status-dev      🟡 -> --accent-doux / --accent
//   status-spec     ⚪ -> --sur-statut / --neutre
//   état inconnu       -> --sur-statut / --badge-etiquette, repli
import projets from "../../data/projets.json";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;

const labels = {
  fr: {
    titre: "Projets",
    tous: "Tous les projets sur GitHub",
    voir: (nom: string) => `Voir le dépôt ${nom} sur GitHub`,
  },
  en: {
    titre: "Projects",
    tous: "All projects on GitHub",
    voir: (nom: string) => `View the ${nom} repository on GitHub`,
  },
};
const t = labels[lang];
// L'instantané est trié en FR ; `ordre[lang]` donne le tri propre à chaque langue.
const liste = [...projets].sort((a, b) => a.ordre[lang] - b.ordre[lang]);

const DEFAULT_BADGE = {
  fond: "var(--sur-statut)",
  texte: "var(--texte)",
  puce: "var(--badge-etiquette)",
};
const badgeStyles: Record<
  string,
  { fond: string; texte: string; puce: string }
> = {
  "status-deployed": {
    fond: "var(--succes-doux)",
    texte: "var(--texte)",
    puce: "var(--succes)",
  },
  "status-refonte": {
    fond: "var(--alerte-doux)",
    texte: "var(--alerte-texte)",
    puce: "var(--alerte)",
  },
  "status-test": {
    fond: "var(--primaire-doux)",
    texte: "var(--texte)",
    puce: "var(--primaire)",
  },
  "status-bench": {
    fond: "var(--sur-statut)",
    texte: "var(--texte)",
    puce: "var(--cat-4)",
  },
  "status-dev": {
    fond: "var(--accent-doux)",
    texte: "var(--texte)",
    puce: "var(--accent)",
  },
  "status-spec": {
    fond: "var(--sur-statut)",
    texte: "var(--texte)",
    puce: "var(--neutre)",
  },
};
---

<section id="projets" class="py-16">
  <h2 class="text-[length:var(--taille-titre-2)]">{t.titre}</h2>
  <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {liste.map((p) => {
      const badge = badgeStyles[p.etat ?? ""] ?? DEFAULT_BADGE;
      return (
        <article
          class="flex flex-col gap-3 rounded-[var(--rayon-moyen)] border p-5"
          style={{
            backgroundColor: "var(--surface)",
            borderColor: "var(--trait)",
          }}
        >
          <h3 class="text-[length:var(--taille-grand)]">{p.nom[lang]}</h3>
          <span
            class="inline-flex w-fit items-center gap-2 rounded-[var(--rayon-moyen)] px-2 py-1 text-[length:var(--taille-petit)]"
            style={{
              backgroundColor: badge.fond,
              color: badge.texte,
              border: `1px solid ${badge.puce}`,
            }}
          >
            {p.etatLabel[lang]}
          </span>
          <p
            class="text-[length:var(--taille-petit)]"
            style={{ color: "var(--texte-attenue)" }}
          >
            {p.description[lang]}
          </p>
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t.voir(p.nom[lang])}
            class="mt-auto"
          >
            GitHub ↗
          </a>
        </article>
      );
    })}
  </div>
  <p class="mt-8">
    <a
      href="https://github.com/Aliquanto3"
      target="_blank"
      rel="noopener noreferrer"
    >
      {t.tous}
    </a>
  </p>
</section>
